# Kgraph 可视化项目 - Git Ignore 文件

# ==================== 依赖目录 ====================
# Node.js 依赖
node_modules/
frontend/node_modules/

# Python 虚拟环境
venv/
env/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.so

# ==================== 构建产物 ====================
# Vite/Webpack 构建输出
dist/
frontend/dist/
build/

# ==================== 日志文件 ====================
# 应用日志
*.log
logs/
kgraph.log
server.log

# npm 日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==================== 编辑器 ====================
# VS Code
.vscode/
*.code-workspace

# JetBrains IDEs
.idea/
*.iml
*.ipr
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# ==================== 系统文件 ====================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ==================== 临时文件 ====================
# 临时文件
tmp/
temp/
.tmp/
*.tmp
*.bak
*.swp

# ==================== 环境配置 ====================
# 环境变量文件（包含敏感信息）
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# 配置文件（如果包含敏感信息）
config.local.js
settings.local.yaml
*.local.json

# ==================== 数据缓存 ====================
# 缓存文件
.cache/
.parcel-cache/
.eslintcache

# ==================== 测试 ====================
# 测试覆盖率
coverage/
.nyc_output/

# ==================== 其他 ====================
# 锁文件（根据项目需要决定是否忽略）
# package-lock.json 通常不忽略，但如果需要可以取消注释
# package-lock.json
# yarn.lock

# 大型数据文件（可选）
# data/*.json
# *.parquet

# ==================== 保留的必要文件 ====================
# 以下文件虽然匹配上述规则，但应该保留
!package.json
!package-lock.json
!requirements.txt
!README.md
!STARTED.md
!docs/

# 发布校验临时文件
.release-check/
